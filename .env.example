# Leafdesk's settings. With docker compose none is required: the first start makes a random auth
# secret and database password in the `secrets` volume. To change something, write it into a file
# named .env next to docker-compose.yml and run `docker compose up -d` again. What is most often
# changed comes first; the full reference follows.

# Public URL of the app (used for OAuth issuer, MCP resource and cookies): set it when people reach
# the app under a domain or another port.
APP_URL=http://localhost:3000
# Port the app listens on (docker compose: on the host).
PORT=3000
# Close sign-up after creating your own account. Existing accounts can still sign in, and people
# you invite from Settings → Members can sign up through their invitation link.
# DISABLE_SIGNUP=true
# docker compose only: image tag to run, e.g. 0.6.2 (default: latest)
# LEAFDESK_VERSION=latest
# Email for invitations and password reset: SMTP_URL (or SMTP_HOST...) and MAIL_FROM, see Email below.

# ---------------------------------------------------------------------------- Full reference

# PostgreSQL. docker compose ignores this one: it uses the bundled database, or
# EXTERNAL_DATABASE_URL (at the end of this file).
DATABASE_URL=postgres://leafdesk:leafdesk@localhost:5432/leafdesk
# Signs sessions; keys derived from it seal secrets in the database. docker compose makes a random
# one when this is unset. Anywhere else it is required (pnpm dev, Dokploy): openssl rand -base64 32
# BETTER_AUTH_SECRET=
# Days a sign-in lasts without use (whole days, 1 to 400, the most a browser keeps the cookie;
# more is read as 400; default 7). Sessions in use are extended.
# SESSION_MAX_AGE_DAYS=7
# Leafdesk on one computer for one person, as the desktop app's "On this computer" runs it (the app
# sets it): single sign-on, SCIM, invitations and join requests, guests, publishing, email and push
# notifications are hidden and refused. Not for a server people share.
# LEAFDESK_LOCAL_MODE=1
# Instance administrators: comma-separated email addresses (any case). An account counts once its
# address is verified (`pnpm auth:verify-email <email>`); it then gets Server administration
# (/admin). See the README (Instance administrators).
# ADMIN_EMAILS=ops@example.com
# Who may create workspaces: everyone (default) or admins. The personal workspace at sign-up is
# always created.
# WORKSPACE_CREATION=admins
# Reverse proxies in front of the app (Traefik, Caddy, nginx...), used to find a visitor's address
# for rate limits and the audit log. Unset: one proxy, trusted only when it connects from a private
# address. Set 0 when clients reach the app directly, 2 behind a CDN plus a proxy.
# TRUSTED_PROXIES=1
# Where people get the source code of what this server runs (About tab, foot of published pages and
# public forms). Unset: this release's tag on GitHub. Running a changed Leafdesk for others? Point it
# at your published changes.
# SOURCE_URL=https://git.example.com/you/leafdesk
# Email (SMTP), needed for invitations and password reset. Without it, development prints
# emails to the server log and production turns those features off. Test with: pnpm mail:test you@example.com
# Either a URL (smtps:// for implicit TLS on 465, smtp:// upgrades with STARTTLS)...
# SMTP_URL=smtp://user:password@smtp.example.com:587
# ...or separate settings. SMTP_PORT defaults to 587, or 465 when SMTP_SECURE=true.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# Sender address; required when SMTP is set.
# MAIL_FROM="Leafdesk <no-reply@example.com>"
# Push notifications to browsers (new inbox items, on the devices where people turn them on). Make
# the key pair with: pnpm push:keys. The subject is an address the browsers' push services can
# reach you at (mailto: or https:). Without all three, push is off and its settings are hidden.
# Changing the keys stops push on every device until it is turned on again there.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.com
# Push services on a private network or plain http that push may reach (a push service run next
# to the server), comma-separated host or host:port. Others must be public https addresses.
# PUSH_ALLOWED_HOSTS=
# Sign in with GitHub and/or Google: set both values of a provider to turn it on. Register the
# callback URL <APP_URL>/api/auth/callback/github (or /google) with the provider.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Single sign-on for the whole server (OpenID Connect): set issuer, client id and secret to turn it
# on. Register the redirect URI <APP_URL>/api/auth/sso/callback/oidc with the provider. OIDC_DOMAINS
# (comma-separated) limits new accounts to those email domains and links existing accounts in them;
# set it for providers that sign in anyone (Google). See the README (Single sign-on).
# OIDC_ISSUER=https://keycloak.example.com/realms/acme
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_NAME=Keycloak
# OIDC_DOMAINS=example.com
# Identity providers on a private network (instance or workspace ones) the server may call, as
# comma-separated origins; the OIDC_ISSUER origin is trusted already.
# SSO_TRUSTED_ORIGINS=http://keycloak:8080
# File uploads (images, video, audio and attachments in pages). By default they are stored on disk
# in UPLOAD_DIR (./data/uploads; the `uploads` volume under docker compose).
# UPLOAD_DIR=./data/uploads
# Largest file, in MB (default 50), and the most one workspace may store, in MB (default 10240; 0 = no limit).
# UPLOAD_MAX_FILE_MB=50
# UPLOAD_WORKSPACE_QUOTA_MB=10240
# S3-compatible storage instead (AWS S3, Cloudflare R2, MinIO...): setting S3_BUCKET switches to it.
# Existing files are not moved when you switch.
# S3_BUCKET=leafdesk
# The service's URL for R2, MinIO and others; leave out for AWS S3.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Address the bucket by path; default true with S3_ENDPOINT, false for AWS.
# S3_FORCE_PATH_STYLE=true
# Optional folder inside the bucket.
# S3_PREFIX=uploads
# ZIP exports (a page with its subpages, or a whole workspace): most pages, and most MB of files, one
# export may hold (defaults 10000 and 2048). Larger exports are refused with a message.
# EXPORT_MAX_PAGES=10000
# EXPORT_MAX_FILES_MB=2048
# REST API (/api/v1): requests per personal access token per minute (default 180; 0 = no limit).
# API_RATE_LIMIT=180
# MCP endpoint (/mcp): requests per user per minute, all their connected apps together (default 120;
# 0 = no limit).
# MCP_RATE_LIMIT=120
# Origins whose browser pages may call the REST API (comma-separated, or *). Unset, only servers and
# scripts can call it; tokens never belong in public web pages.
# API_CORS_ORIGINS=https://tools.example.com
# Database automation webhooks only reach public addresses on ports 80, 443, 8080 and 8443. Hosts
# listed here (comma-separated, a host name or host:port) may be on a private network or a local
# name, e.g. an n8n container next to Leafdesk. See the README (Automations and webhooks).
# AUTOMATION_WEBHOOK_ALLOWED_HOSTS=n8n,localhost:5678
# How often "a date passes" automations look for rows whose date has come, in seconds (default
# 600, at least 10).
# AUTOMATION_DATE_CHECK_SECONDS=600
# Connections (Settings → Connections) reach only public https MCP servers. Hosts listed here
# (comma-separated, a host name or host:port) may be on a private network, a local name or plain
# http. See the README (Connections).
# CONNECTOR_ALLOWED_HOSTS=mcp-gateway,localhost:8931
# Email on rows (Settings → Email): members' mailboxes are reached only on public addresses over
# TLS. Mail servers listed here (comma-separated, a host name or host:port) may be on a private
# network or a local name, and are reached without TLS too. See the README (Email on rows).
# MAIL_ALLOWED_HOSTS=mail.office.lan,localhost:3143
# Own storage: OWN_STORAGE_ENABLED=true lets people connect their own S3-compatible bucket, Google
# Drive or Dropbox (Account → Apps → Connected storage) and keep workspaces' uploads there. Off
# by default: uploads go to the server's storage above. See the README (A workspace's own storage).
# OWN_STORAGE_ENABLED=false
# Owners' S3 endpoints are reached only on public
# https addresses. Hosts listed here (comma-separated, a host name or host:port) may be on a private
# network, a local name or plain http (MinIO next to Leafdesk, say). See the README (File uploads).
# STORAGE_ALLOWED_HOSTS=minio:9000
# Owners can also keep a workspace's uploads in their Google Drive or Dropbox: register an app with
# each and set both its values to offer it. Register the redirect URI
# <APP_URL>/api/storage/oauth/callback with both. Google: an OAuth client of type "Web application"
# with the Drive API enabled and the scope .../auth/drive.file. Dropbox: a scoped app with "App
# folder" access and the permissions account_info.read, files.content.read and files.content.write.
# See the README (A workspace's own storage).
# STORAGE_GDRIVE_CLIENT_ID=
# STORAGE_GDRIVE_CLIENT_SECRET=
# STORAGE_DROPBOX_CLIENT_ID=
# STORAGE_DROPBOX_CLIENT_SECRET=
# Some services (Slack, HubSpot, Asana…) sign in only OAuth apps registered with them. Owners can
# enter their own app's client ID and secret on the connection; or register one app per service for
# the whole instance here, by catalog id (comma-separated; leave out ":SECRET" for an app without
# one). Each app's redirect URL is APP_URL/api/connections/oauth/callback.
# CONNECTION_OAUTH_CLIENTS=slack=CLIENT_ID:CLIENT_SECRET,discord=CLIENT_ID
# Key that seals connections' tokens and signing secrets in the database (at least 32 characters;
# openssl rand -base64 32). Unset, one is derived from BETTER_AUTH_SECRET. When you change it, keep
# the old one in LEAFDESK_ENCRYPTION_OLD_KEYS (comma-separated) so what it sealed still opens.
# LEAFDESK_ENCRYPTION_KEY=
# LEAFDESK_ENCRYPTION_OLD_KEYS=
# An automation that sets a date to "now" uses the server's day: set TZ to your time zone (a
# container runs in UTC otherwise).
# TZ=Europe/Istanbul
# AI features (writing assistant, AI autofill properties): off unless AI_PROVIDER and AI_MODEL are
# set. Providers: anthropic, openai, google, opencode-go (an OpenCode Go subscription; any of its
# models, e.g. kimi-k3), openai-compatible (any /v1/chat/completions server), ollama, lmstudio
# (local; default URLs http://localhost:11434/v1 and http://localhost:1234/v1).
# AI_PROVIDER=anthropic
# AI_MODEL=claude-haiku-5-5
# Key for hosted providers (or ANTHROPIC_API_KEY / OPENAI_API_KEY / GEMINI_API_KEY /
# OPENCODE_API_KEY); local ones need none.
# AI_API_KEY=
# Endpoint override; required for openai-compatible. In Docker, a model on the host is at
# http://host.docker.internal:11434/v1.
# AI_BASE_URL=
# A cheaper model at the same provider (same key and endpoint) for AI property values and writing
# up voice notes; everything else stays on AI_MODEL. Unset, AI_MODEL answers everything. Own AI
# accounts always use their own model. See the README's AI section.
# AI_FAST_MODEL=claude-haiku-5-5
# Embeddings for semantic search (OpenAI-compatible /embeddings). The endpoint defaults to the chat
# provider's (OpenAI, Google, local servers; Anthropic and OpenCode Go have none), and so does the
# key.
# AI_EMBEDDINGS_MODEL=text-embedding-3-small
# AI_EMBEDDINGS_BASE_URL=
# AI_EMBEDDINGS_API_KEY=
# AI_EMBEDDINGS_DIMENSIONS=
# Lowest cosine similarity a passage needs to count as a semantic match (0 to below 1).
# AI_EMBEDDINGS_MIN_SIMILARITY=0.3
# Limits: prompt characters per request (48000), answer tokens (8192; a model that thinks spends its
# thinking from them too), timeout (60 s), requests per person (20) and per workspace (120) per
# minute, AI property values worked out at once (2), and the context window assumed for
# openai-compatible and local models (32768).
# AI_MAX_INPUT_CHARS=48000
# AI_MAX_OUTPUT_TOKENS=8192
# AI_TIMEOUT_SECONDS=60
# AI_RATE_LIMIT=20
# AI_WORKSPACE_RATE_LIMIT=120
# AI_CONCURRENCY=2
# AI_CONTEXT_WINDOW=32768
# Voice notes: speech to text over an OpenAI-compatible /audio/transcriptions endpoint, set apart
# from the chat model. Off unless STT_PROVIDER and STT_MODEL are set. Providers: openai (key in
# STT_API_KEY or OPENAI_API_KEY), openai-compatible (STT_BASE_URL required, e.g. a local Whisper
# server).
# STT_PROVIDER=openai
# STT_MODEL=whisper-1
# STT_BASE_URL=
# STT_API_KEY=
# Longest recording (600 s), largest audio file (25 MB) and timeout (120 s).
# STT_MAX_SECONDS=600
# STT_MAX_MB=25
# STT_TIMEOUT_SECONDS=120
# People's own AI keys (Settings → Apps → AI): off unless set. Each person adds their provider key
# once, and a workspace runs all its AI on one owner's account; without one, on the AI_* settings
# above. See the README (Your own AI keys).
# OWN_AI_KEYS_ENABLED=true
# Keep the AI_* settings above from workspaces: without an account of its own, a workspace has no AI.
# AI_ONLY_OWN_KEYS=true
# Own accounts' OpenAI-compatible servers are reached only on public https addresses. Hosts listed
# here (comma-separated, a host name or host:port) may be on a private network, a local name or
# plain http.
# AI_ALLOWED_HOSTS=vllm:8000
# Daily cleanup of the trash and old page history: runs on production servers; on or off to override.
# RETENTION_JOB=on
# docker compose only: password of the bundled PostgreSQL, applied when its volume is first
# created. Unset, a random one is made (in the `secrets` volume). Set it in an older install's .env,
# keep it: it is the password its database was created with. For `pnpm dev`, use it in DATABASE_URL
# above too.
# POSTGRES_PASSWORD=
# docker compose only: connection URL of an external PostgreSQL 18, and BUNDLED_DB=0 so the bundled
# one isn't started.
# EXTERNAL_DATABASE_URL=postgres://user:password@host:5432/leafdesk
# BUNDLED_DB=0
# docker compose only: host port for PostgreSQL (bound to 127.0.0.1)
# DB_PORT=5432
