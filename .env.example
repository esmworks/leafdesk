# Public URL of the app (used for OAuth issuer, MCP resource and cookies)
APP_URL=http://localhost:3000
PORT=3000
DATABASE_URL=postgres://leafdesk:leafdesk@localhost:5432/leafdesk
# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Close sign-up after creating your own account. Existing accounts can still sign in, and people
# you invite from Settings → Members can sign up through their invitation link.
# DISABLE_SIGNUP=true
# Days a sign-in lasts without use (whole days, 1 to 3650; default 7). Sessions in use are extended.
# SESSION_MAX_AGE_DAYS=7
# Instance administrators: comma-separated email addresses (any case). An account counts once its
# address is verified (`pnpm auth:verify-email <email>`); it then gets Server administration
# (/admin). See the README (Instance administrators).
# ADMIN_EMAILS=ops@example.com
# Who may create workspaces: everyone (default) or admins. The personal workspace at sign-up is
# always created.
# WORKSPACE_CREATION=admins
# Reverse proxies in front of the app (Traefik, Caddy, nginx...), used to find a visitor's address
# for public form limits. Set 0 when clients reach the app directly, 2 behind a CDN plus a proxy.
# TRUSTED_PROXIES=1
# Email (SMTP), needed for invitations and password reset. Without it, development prints
# emails to the server log and production turns those features off. Test with: pnpm mail:test you@example.com
# Either a URL (smtps:// for implicit TLS on 465, smtp:// upgrades with STARTTLS)...
# SMTP_URL=smtp://user:password@smtp.example.com:587
# ...or separate settings. SMTP_PORT defaults to 587, or 465 when SMTP_SECURE=true.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# Sender address; required when SMTP is set.
# MAIL_FROM="Leafdesk <no-reply@example.com>"
# Sign in with GitHub and/or Google: set both values of a provider to turn it on. Register the
# callback URL <APP_URL>/api/auth/callback/github (or /google) with the provider.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Single sign-on for the whole server (OpenID Connect): set issuer, client id and secret to turn it
# on. Register the redirect URI <APP_URL>/api/auth/sso/callback/oidc with the provider. OIDC_DOMAINS
# (comma-separated) limits new accounts to those email domains and links existing accounts in them;
# set it for providers that sign in anyone (Google). See the README (Single sign-on).
# OIDC_ISSUER=https://keycloak.example.com/realms/acme
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_NAME=Keycloak
# OIDC_DOMAINS=example.com
# Identity providers on a private network (instance or workspace ones) the server may call, as
# comma-separated origins; the OIDC_ISSUER origin is trusted already.
# SSO_TRUSTED_ORIGINS=http://keycloak:8080
# File uploads (images, video, audio and attachments in pages). By default they are stored on disk
# in UPLOAD_DIR (./data/uploads; the `uploads` volume under docker compose).
# UPLOAD_DIR=./data/uploads
# Largest file, in MB (default 50), and the most one workspace may store, in MB (default 10240; 0 = no limit).
# UPLOAD_MAX_FILE_MB=50
# UPLOAD_WORKSPACE_QUOTA_MB=10240
# S3-compatible storage instead (AWS S3, Cloudflare R2, MinIO...): setting S3_BUCKET switches to it.
# Existing files are not moved when you switch.
# S3_BUCKET=leafdesk
# The service's URL for R2, MinIO and others; leave out for AWS S3.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Address the bucket by path; default true with S3_ENDPOINT, false for AWS.
# S3_FORCE_PATH_STYLE=true
# Optional folder inside the bucket.
# S3_PREFIX=uploads
# ZIP exports (a page with its subpages, or a whole workspace): most pages, and most MB of files, one
# export may hold (defaults 10000 and 2048). Larger exports are refused with a message.
# EXPORT_MAX_PAGES=10000
# EXPORT_MAX_FILES_MB=2048
# REST API (/api/v1): requests per personal access token per minute (default 180; 0 = no limit).
# API_RATE_LIMIT=180
# Origins whose browser pages may call the REST API (comma-separated, or *). Unset, only servers and
# scripts can call it; tokens never belong in public web pages.
# API_CORS_ORIGINS=https://tools.example.com
# Database automation webhooks only reach public addresses on ports 80, 443, 8080 and 8443. Hosts
# listed here (comma-separated, a host name or host:port) may be on a private network or a local
# name, e.g. an n8n container next to Leafdesk. See the README (Automations and webhooks).
# AUTOMATION_WEBHOOK_ALLOWED_HOSTS=n8n,localhost:5678
# AI features (writing assistant, AI autofill properties): off unless AI_PROVIDER and AI_MODEL are
# set. Providers: anthropic, openai, google, opencode-go (an OpenCode Go subscription; any of its
# models, e.g. kimi-k3), openai-compatible (any /v1/chat/completions server), ollama, lmstudio
# (local; default URLs http://localhost:11434/v1 and http://localhost:1234/v1).
# AI_PROVIDER=anthropic
# AI_MODEL=claude-haiku-4-5
# Key for hosted providers (or ANTHROPIC_API_KEY / OPENAI_API_KEY / GEMINI_API_KEY /
# OPENCODE_API_KEY); local ones need none.
# AI_API_KEY=
# Endpoint override; required for openai-compatible. In Docker, a model on the host is at
# http://host.docker.internal:11434/v1.
# AI_BASE_URL=
# Embeddings for semantic search (OpenAI-compatible /embeddings). The endpoint defaults to the chat
# provider's (OpenAI, Google, local servers; Anthropic and OpenCode Go have none), and so does the
# key.
# AI_EMBEDDINGS_MODEL=text-embedding-3-small
# AI_EMBEDDINGS_BASE_URL=
# AI_EMBEDDINGS_API_KEY=
# AI_EMBEDDINGS_DIMENSIONS=
# Lowest cosine similarity a passage needs to count as a semantic match (0 to below 1).
# AI_EMBEDDINGS_MIN_SIMILARITY=0.3
# Limits: prompt characters per request (48000), answer tokens (2048), timeout (60 s), requests per
# person (20) and per workspace (120) per minute, AI property values worked out at once (2), and the
# context window assumed for openai-compatible and local models (32768).
# AI_MAX_INPUT_CHARS=48000
# AI_MAX_OUTPUT_TOKENS=2048
# AI_TIMEOUT_SECONDS=60
# AI_RATE_LIMIT=20
# AI_WORKSPACE_RATE_LIMIT=120
# AI_CONCURRENCY=2
# AI_CONTEXT_WINDOW=32768
# Daily cleanup of the trash and old page history: runs on production servers; on or off to override.
# RETENTION_JOB=on
# docker compose only: run the bundled PostgreSQL. Remove this line to use an external database.
COMPOSE_PROFILES=bundled-db
# docker compose only: PostgreSQL password, applied when the database volume is first created.
# If you change it, update DATABASE_URL above to match.
# POSTGRES_PASSWORD=leafdesk
# docker compose only: connection URL of an external PostgreSQL 18 (used when the bundled one is off)
# EXTERNAL_DATABASE_URL=postgres://user:password@host:5432/leafdesk
# docker compose only: host port for PostgreSQL (bound to 127.0.0.1)
# DB_PORT=5432
# docker compose only: image tag to run, e.g. 0.2.0 (default: latest)
# LEAFDESK_VERSION=latest
