{
  "name": "leafdesk",
  "version": "0.4.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false server.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "mail:test": "tsx scripts/send-test-email.ts",
    "auth:reset-2fa": "tsx scripts/reset-two-factor.ts",
    "auth:verify-email": "tsx scripts/verify-email.ts",
    "search:index": "tsx scripts/semantic-index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "i18n:check": "tsx scripts/i18n-check.ts",
    "test": "vitest run",
    "auth:schema": "auth generate --config scripts/auth-schema.config.ts --output src/db/schema/auth.ts --adapter drizzle --dialect postgresql --yes"
  },
  "dependencies": {
    "@better-auth/cimd": "^1.7.6",
    "@better-auth/mcp": "^1.7.6",
    "@better-auth/oauth-provider": "1.7.6",
    "@better-auth/passkey": "1.7.6",
    "@better-auth/sso": "1.7.6",
    "@blocknote/core": "^0.55.0",
    "@blocknote/mantine": "^0.55.0",
    "@blocknote/react": "^0.55.0",
    "@blocknote/server-util": "^0.55.0",
    "@earendil-works/pi-ai": "0.87.1",
    "@hocuspocus/provider": "^4.7.0",
    "@hocuspocus/server": "^4.7.0",
    "@mantine/core": "^9.6.2",
    "@mantine/hooks": "^9.6.2",
    "@modelcontextprotocol/server": "^2.1.0",
    "@tiptap/core": "^3.31.3",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.6",
    "crossws": "^0.4.12",
    "drizzle-orm": "^0.45.3",
    "fflate": "0.8.3",
    "katex": "0.18.9",
    "lucide-react": "^1.48.0",
    "mermaid": "12.0.0",
    "next": "^16.3.6",
    "next-intl": "4.14.7",
    "nodemailer": "^10.0.10",
    "postgres": "^3.4.9",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tsx": "^4.23.15",
    "unpdf": "1.8.1",
    "uqr": "0.1.3",
    "y-indexeddb": "9.0.12",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.20",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "auth": "1.7.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.9.0"
}
